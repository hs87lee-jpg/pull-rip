# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 GitHub에 올라가지 않습니다.
# 개발 중에는 시험 프로젝트 값만 넣습니다.

NEXT_PUBLIC_SUPABASE_URL=https://vzytphssywwoebftqduw.supabase.co
# Supabase 대시보드 → Project Settings → API Keys → Publishable key (sb_publishable_ 로 시작)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret / service_role 키는 여기에 넣지 않습니다. 이관 스크립트가 필요해질 때 따로 안내합니다.
